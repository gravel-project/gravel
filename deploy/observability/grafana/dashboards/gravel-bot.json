        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "min(gravel_bot_gateway_connected{job=\"$job\", instance=~\"$instance\"})",
          "legendFormat": "ready",
          "range": true,
          "refId": "A"
        }
      ],
