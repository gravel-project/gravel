              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gravelOptional": "the gateway is off or not ready",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "id": 9,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(gravel_bot_gateway_latency_seconds{job=\"$job\", instance=~\"$instance\"})",
          "legendFormat": "latency",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Gateway heartbeat latency",
      "type": "timeseries"
