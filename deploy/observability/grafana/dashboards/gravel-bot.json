                  "text": "Not registered"
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": "Registered"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": ""
        },
        "overrides": []
      },
      "gravelOptional": "Linked Roles are off (linked_roles.enabled)",
