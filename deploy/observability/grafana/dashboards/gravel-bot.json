      "id": 13,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum by (route) (rate(gravel_bot_interactions_total{job=\"$job\", instance=~\"$instance\", result=\"error\"}[$__rate_interval])) or sum by (route) (rate(gravel_bot_interactions_total{job=\"$job\", instance=~\"$instance\"}[$__rate_interval])) * 0) / sum by (route) (rate(gravel_bot_interactions_total{job=\"$job\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{route}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Interaction error ratio",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 14,
      "panels": [],
