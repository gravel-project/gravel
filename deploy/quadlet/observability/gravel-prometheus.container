# Prometheus for gravel (ADR-0009), pinned by index digest: docker.io/prom/prometheus v3.15.0
# (amd64 and arm64 among its platforms). Config: ~/.config/gravel/prometheus.yml, a copy of
# deploy/observability/prometheus/quadlet.yml. It scrapes gravel-hub:9090 and gravel-bot:9091 on
# gravel.network; 127.0.0.1:9092 is for an operator's ad-hoc queries. 30 days or 2 GB, whichever
# comes first; the data is not backed up (it rebuilds as it scrapes).
[Unit]
Description=gravel Prometheus

[Container]
Image=docker.io/prom/prometheus@sha256:efd719c99d83b060d9daefdcf00360461adf279f45ef5391f8d111892118753e
ContainerName=gravel-prometheus
Network=gravel.network
PublishPort=127.0.0.1:9092:9090
Volume=%h/.config/gravel/prometheus.yml:/etc/prometheus/prometheus.yml:ro,Z
Volume=gravel-prometheus.volume:/prometheus
Exec=--config.file=/etc/prometheus/prometheus.yml --storage.tsdb.path=/prometheus --storage.tsdb.retention.time=30d --storage.tsdb.retention.size=2GB
HealthCmd=["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:9090/-/ready"]
HealthInterval=30s
HealthTimeout=3s
HealthRetries=3

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
