# gravel's Discord bot (docs/bot.md): the stock modules against this stack's hub, pinned by digest
# to a release of ghcr.io/gravel-project/gravel-bot (0.6.2; the index digest covers amd64 and
# arm64). docs/releasing.md says how to verify a release and move the pin. For a local build use
# `make bot-image` and Image=localhost/gravel-bot:dev. Config: ~/.config/gravel/bot.yaml. Secrets:
# the bot token and the hub client secret (`gravel-hub apps create`), both podman secrets mounted
# as files.
[Unit]
Description=gravel bot
Requires=gravel-hub.service
After=gravel-hub.service

[Container]
Image=ghcr.io/gravel-project/gravel-bot@sha256:58086e3a7abb12c0268d9ce0e3dc8c70011cfe6f46a7fdb917d3e825c9416153
ContainerName=gravel-bot
Network=gravel.network
PublishPort=127.0.0.1:8081:8081
PublishPort=127.0.0.1:9091:9091
Volume=%h/.config/gravel/bot.yaml:/etc/gravel/bot.yaml:ro,Z
Secret=gravel-bot-discord-token
Secret=gravel-bot-hub-client-secret
Exec=serve --config /etc/gravel/bot.yaml
# Exec form on purpose: a plain string runs through /bin/sh -c, and the distroless image has no shell.
HealthCmd=["CMD", "/ko-app/gravel-bot", "healthcheck"]
HealthInterval=30s
HealthTimeout=3s
HealthRetries=3

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
