# The gravel hub, pinned by digest to a release of ghcr.io/gravel-project/gravel-hub (0.6.3; the
# index digest covers amd64 and arm64). docs/releasing.md says how to verify a release and move
# the pin. For a local build use `make image` and Image=localhost/gravel-hub:dev.
# Config: ~/.config/gravel/hub.yaml (docs/hub.md). Secret: gravel-db-url
# (`podman secret create gravel-db-url <file>`, the file holding the postgres:// URL). With login
# enabled, also gravel-discord-client-secret and, optionally, gravel-steam-api-key.
[Unit]
Description=gravel hub
Requires=gravel-postgres.service
After=gravel-postgres.service

[Container]
Image=ghcr.io/gravel-project/gravel-hub@sha256:4b26b8d81f9bcde9e80b9b2a3ead351ed5af605a9004f2cac345c0718e4d6c5c
ContainerName=gravel-hub
Network=gravel.network
PublishPort=127.0.0.1:8080:8080
PublishPort=127.0.0.1:9090:9090
Volume=%h/.config/gravel/hub.yaml:/etc/gravel/hub.yaml:ro,Z
Secret=gravel-db-url
# Secret=gravel-discord-client-secret
# Secret=gravel-steam-api-key
Exec=serve --config /etc/gravel/hub.yaml
# Exec form on purpose: a plain string runs through /bin/sh -c, and the distroless image has no shell.
HealthCmd=["CMD", "/ko-app/gravel-hub", "healthcheck"]
HealthInterval=30s
HealthTimeout=3s
HealthRetries=3

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
