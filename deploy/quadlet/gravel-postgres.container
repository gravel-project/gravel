# Postgres 17 for the hub, from gravel's mirror on ghcr.io (#233), pinned to the digest
# deploy/postgres/Containerfile builds on. Secret: gravel-db-password
# (`podman secret create gravel-db-password <file>`).
[Unit]
Description=Postgres for the gravel hub

[Container]
Image=ghcr.io/gravel-project/mirror/postgres:17@sha256:31ba9c94a03ada9988f2bb493a22a75eef3a185884533e5cdbcd498ea835b08f
ContainerName=gravel-postgres
Network=gravel.network
Volume=gravel-postgres.volume:/var/lib/postgresql/data
Environment=POSTGRES_USER=gravel POSTGRES_DB=gravel POSTGRES_PASSWORD_FILE=/run/secrets/gravel-db-password
Secret=gravel-db-password
HealthCmd=pg_isready -U gravel -d gravel
HealthInterval=10s
HealthTimeout=3s
HealthRetries=6

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
