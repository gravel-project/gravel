#!/bin/bash
{{ .FirstBootComment }}
set -euo pipefail
user={{ .User }}
home=/home/$user
{{ .FirstBootVars }}

mountpoint -q "$home" || { echo "first-boot: $home is not mounted: is the data volume attached?" >&2; exit 1; }

# The volume's first boot: give the home to the user, with the usual dotfiles and SELinux labels.
# On a later instance the volume already carries all of it, and relabelling podman's storage
# would be wrong, so nothing here runs twice.
if [[ ! -e "$home_marker" ]]; then
  chown "$user:$user" "$home"
  chmod 0700 "$home"
  cp -r --update=none /etc/skel/. "$home/"
  chown -R "$user:$user" "$home"
  restorecon -R "$home"
  install -o "$user" -g "$user" -m 0644 /dev/null "$home_marker"
fi

# The user's systemd instance outlives logins (linger lives on the root disk, so every instance
# sets it); wait until it answers before talking to it. Its bus socket appears before the manager
# is ready, so waiting for the socket alone is a race: Fedora 44's systemd 259 widened it, and the
# first `systemctl --user` was refused ("Failed to connect to user scope bus"), first-boot failed
# and no host booted (2026-10-12, HTG's htg-cs2-1 and the hub-vm drill).
loginctl enable-linger "$user"
uid=$(id -u "$user")
as_user() { runuser -u "$user" -- env HOME="$home" XDG_RUNTIME_DIR="/run/user/$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" "$@"; }
for _ in $(seq 1 120); do
  as_user systemctl --user show-environment >/dev/null 2>&1 && break
  sleep 1
done
as_user systemctl --user show-environment >/dev/null ||
  { echo "first-boot: $user's systemd instance did not answer in 2 minutes (systemctl status user@$uid)" >&2; exit 1; }
{{- .FirstBootTail }}

echo "first-boot: done"
