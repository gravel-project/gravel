package templates

// Layout wraps a page's content: the head with the theme and app stylesheets and htmx, the
// header with the organization, the host's links and the account menu, the main landmark the
// htmx swaps target, and the footer.
templ Layout(p Page) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content={ HTMXConfig }/>
			<title>{ p.Title } · { p.Org.Name }</title>
			<link rel="stylesheet" href="/theme.css"/>
			<link rel="stylesheet" href="/static/app.css"/>
			if p.Theme.FaviconURL != "" {
				<link rel="icon" href={ templ.URL(p.Theme.FaviconURL) }/>
			}
			<script src="/static/vendor/htmx.min.js" defer></script>
		</head>
		<body>
			<a class="skip" href="#page">Skip to content</a>
			if p.Org.Demo {
				<section class="demo" aria-label="Demo hub">
					<p>{ DemoNotice }</p>
				</section>
			}
			<header class="top">
				<a class="brand" href="/">
					if p.Theme.LogoURL != "" {
						<img class="logo" src={ templ.URL(p.Theme.LogoURL) } alt="" width="28" height="28"/>
					}
					{ p.Org.Name }
				</a>
				<nav aria-label="Site">
					<a href="/servers">Servers</a>
					<a href="/boards">Leaderboards</a>
					if p.User != nil && p.User.CanGrant {
						<a href="/admin/people">People</a>
					}
					for _, l := range p.HeaderNav {
						<a href={ templ.URL(l.URL) }>{ l.Label }</a>
					}
				</nav>
				<nav aria-label="Account">
					if p.User != nil {
						<a href="/account">{ p.User.DisplayName }</a>
						<form method="post" action="/auth/logout" class="inline" hx-post="/auth/logout">
							<input type="hidden" name="_csrf" value={ p.CSRF }/>
							<button type="submit" class="link">Log out</button>
						</form>
					} else if p.CanLogIn {
						<a href="/login">Log in</a>
					}
				</nav>
			</header>
			<main id="page" tabindex="-1">
				{ children... }
			</main>
			<footer class="bottom">
				if len(p.FooterNav) > 0 {
					<nav aria-label="More">
						for _, l := range p.FooterNav {
							<a href={ templ.URL(l.URL) }>{ l.Label }</a>
						}
					</nav>
				}
				<p>Powered by gravel.</p>
			</footer>
		</body>
	</html>
}

// FlashView shows a one-shot message, or nothing.
templ FlashView(f *Flash) {
	if f != nil {
		<p class={ "flash", "flash-" + f.Kind } role="status">{ f.Text }</p>
	}
}

// GameScope renders a game's page content inside its overlay (gravel#66): data-game, which
// /theme.css gives the game's accent, then its banner and its links. Off a game's pages it is the
// content alone. It sits in the content, not the layout, so an htmx swap of #page carries it.
templ GameScope(g *Game) {
	if g == nil {
		{ children... }
	} else {
		<div class="game" data-game={ g.ID }>
			if g.BannerURL != "" {
				<img class="game-banner" src={ templ.URL(g.BannerURL) } alt={ g.BannerAlt }/>
			}
			if len(g.Nav) > 0 {
				<nav class="game-nav" aria-label={ g.Name }>
					for _, l := range g.Nav {
						<a href={ templ.URL(l.URL) }>{ l.Label }</a>
					}
				</nav>
			}
			{ children... }
		</div>
	}
}
