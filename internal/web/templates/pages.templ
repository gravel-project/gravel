package templates

import "strconv"

// Login is the whole login page.
templ Login(p LoginPage) {
	@Layout(p.Page) {
		@LoginContent(p)
	}
}

// LoginContent is the login page's main content; an htmx request gets only this.
templ LoginContent(p LoginPage) {
	@FlashView(p.Flash)
	<h1>Log in</h1>
	if p.Local && p.LocalFirst {
		@localLoginForm(p)
	}
	if len(p.Providers) > 0 {
		<ul class="providers">
			for _, pr := range p.Providers {
				<li>
					<a class="button" href={ templ.SafeURL("/auth/" + pr.Name + "/start") }>Log in with { pr.DisplayName }</a>
					if pr.LastUsed {
						<span class="muted">last used here</span>
					}
				</li>
			}
		</ul>
	}
	if p.Local && !p.LocalFirst {
		@localLoginForm(p)
	}
	if len(p.Providers) == 0 && !p.Local {
		<p>No login provider is configured on this hub yet.</p>
	}
}

// localLoginForm is the username and password form (ADR-0026). It posts with no session, so it
// carries no CSRF token: cross-origin posts are refused before any page runs.
templ localLoginForm(p LoginPage) {
	<section aria-labelledby="local-heading">
		<h2 id="local-heading">Username and password</h2>
		<form method="post" action="/auth/local/login">
			<label for="local-username">Username</label>
			<input type="text" id="local-username" name="username" value={ p.Username } autocomplete="username" autocapitalize="none" spellcheck="false" maxlength="32" required/>
			<label for="local-password">Password</label>
			<input type="password" id="local-password" name="password" autocomplete="current-password" maxlength="1024" required/>
			<p><button type="submit">Log in</button></p>
		</form>
		if p.Register {
			<p>No account yet? <a href="/auth/local/register">Make one</a>.</p>
		}
	</section>
}

// Reset is the whole page a password link opens.
templ Reset(p ResetPage) {
	@Layout(p.Page) {
		@ResetContent(p)
	}
}

// ResetContent asks for the new password. The link is a password for an hour, so the page sends
// no referrer and the access log never holds its path.
templ ResetContent(p ResetPage) {
	@FlashView(p.Flash)
	if p.Set {
		<h1>Choose your password</h1>
	} else {
		<h1>Choose a new password</h1>
	}
	<form method="post" action={ templ.SafeURL(p.Action) }>
		<p>Your username is <strong>{ p.Username }</strong>. This link works once, for an hour.</p>
		<input type="text" name="username" value={ p.Username } autocomplete="username" hidden aria-hidden="true" readonly/>
		<label for="reset-password">Password</label>
		<p class="muted" id="reset-password-hint">At least { strconv.Itoa(p.MinPasswordLength) } characters. A sentence you'll remember works well. Every other session of yours ends.</p>
		<input type="password" id="reset-password" name="password" aria-describedby="reset-password-hint" autocomplete="new-password" minlength={ strconv.Itoa(p.MinPasswordLength) } maxlength="1024" required/>
		<p><button type="submit">Set the password and log in</button></p>
	</form>
}

// Register is the whole registration page.
templ Register(p RegisterPage) {
	@Layout(p.Page) {
		@RegisterContent(p)
	}
}

// RegisterContent is the registration form.
templ RegisterContent(p RegisterPage) {
	@FlashView(p.Flash)
	<h1>Make an account</h1>
	<form method="post" action="/auth/local/register">
		<label for="register-username">Username</label>
		<p class="muted" id="register-username-hint">3 to 32 letters a-z, digits, and . _ - ; it starts with a letter or a digit. Others see it.</p>
		<input type="text" id="register-username" name="username" value={ p.Username } aria-describedby="register-username-hint" autocomplete="username" autocapitalize="none" spellcheck="false" maxlength="32" required/>
		<label for="register-password">Password</label>
		<p class="muted" id="register-password-hint">At least { strconv.Itoa(p.MinPasswordLength) } characters. A sentence you'll remember works well.</p>
		<input type="password" id="register-password" name="password" aria-describedby="register-password-hint" autocomplete="new-password" minlength={ strconv.Itoa(p.MinPasswordLength) } maxlength="1024" required/>
		<p><button type="submit">Make the account</button></p>
	</form>
	<p>Already have one? <a href="/login">Log in</a>.</p>
}

// Account is the whole account page.
templ Account(p AccountPage) {
	@Layout(p.Page) {
		@AccountContent(p)
	}
}

// AccountContent is the account page's main content; an htmx form targets it.
templ AccountContent(p AccountPage) {
	@FlashView(p.Flash)
	<h1>
		{ p.User.DisplayName }
		if p.User.Owner {
			<span class="badge">owner</span>
		}
	</h1>
	<section aria-labelledby="identities-heading">
		<h2 id="identities-heading">Linked accounts</h2>
		<table>
			<thead>
				<tr>
					<th scope="col">Provider</th>
					<th scope="col">Account</th>
					<th scope="col">Proven</th>
					<th scope="col"><span class="visually-hidden">Actions</span></th>
				</tr>
			</thead>
			<tbody>
				for _, i := range p.Identities {
					<tr>
						<td>{ i.ProviderDisplay }</td>
						<td>
							if i.AvatarURL != "" {
								<img class="avatar" src={ templ.URL(i.AvatarURL) } alt="" width="24" height="24"/>
							}
							{ i.Label() }
						</td>
						<td>{ i.VerifiedAt.Format("2006-01-02") } ({ i.Method })</td>
						<td>
							if i.CanUnlink {
								<form method="post" action="/account/unlink" class="inline" hx-post="/account/unlink" hx-target="#page" hx-swap="innerHTML">
									<input type="hidden" name="_csrf" value={ p.CSRF }/>
									<input type="hidden" name="provider" value={ i.Provider }/>
									<input type="hidden" name="subject" value={ i.Subject }/>
									<button type="submit" class="link">Unlink { i.ProviderDisplay }</button>
								</form>
							} else {
								<span class="muted">your only account</span>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
		if len(p.LinkProviders) > 0 {
			<ul class="providers">
				for _, pr := range p.LinkProviders {
					<li><a class="button" href={ templ.SafeURL("/auth/" + pr.Name + "/link") }>Link { pr.DisplayName }</a></li>
				}
			</ul>
		}
		if p.Local != nil {
			<h3>Log in with a username and password too</h3>
			<form method="post" action="/account/local">
				<input type="hidden" name="_csrf" value={ p.CSRF }/>
				<label for="account-local-username">Username</label>
				<input type="text" id="account-local-username" name="username" autocomplete="username" autocapitalize="none" spellcheck="false" maxlength="32" required/>
				<label for="account-local-password">Password</label>
				<p class="muted" id="account-local-password-hint">At least { strconv.Itoa(p.Local.MinPasswordLength) } characters.</p>
				<input type="password" id="account-local-password" name="password" aria-describedby="account-local-password-hint" autocomplete="new-password" minlength={ strconv.Itoa(p.Local.MinPasswordLength) } maxlength="1024" required/>
				<p><button type="submit">Set the username and password</button></p>
			</form>
		}
		for _, pr := range p.RoleProviders {
			<p class="muted">After linking or unlinking an account, update what { pr.DisplayName } knows, so its linked roles follow.</p>
			<ul class="providers">
				<li><a class="button" href={ templ.SafeURL("/auth/" + pr.Name + "/roles") }>Update { pr.DisplayName } linked roles</a></li>
			</ul>
		}
	</section>
	if len(p.ProofServers) > 0 {
		<section aria-labelledby="proof-heading">
			<h2 id="proof-heading">Prove an account in game</h2>
			<p>Get a one-time code, join one of these servers and type it in chat. The server's log names the account you play as, and the hub links it to you, or proves a link you have again.</p>
			<form method="post" action="/account/prove">
				<input type="hidden" name="_csrf" value={ p.CSRF }/>
				<label for="proof-server">Server</label>
				<select id="proof-server" name="server_id">
					for _, s := range p.ProofServers {
						<option value={ s.ID }>{ s.Name }</option>
					}
				</select>
				if len(p.ProofAccounts) > 0 {
					<label for="proof-subject">Account</label>
					<select id="proof-subject" name="subject">
						<option value="">A new account</option>
						for _, i := range p.ProofAccounts {
							<option value={ i.Subject }>{ i.ProviderDisplay } { i.Label() }, again</option>
						}
					</select>
				}
				<button type="submit">Get a code</button>
			</form>
		</section>
	}
	<p><a href="/profile">Your stats and leaderboard name</a></p>
	if len(p.Apps) > 0 {
		<section aria-labelledby="apps-heading">
			<h2 id="apps-heading">Apps you allowed</h2>
			<p class="muted">These apps can act as you, within what you allowed. Revoking one signs you out of it and it must ask again.</p>
			<table>
				<thead>
					<tr>
						<th scope="col">App</th>
						<th scope="col">Allowed to</th>
						<th scope="col">Since</th>
						<th scope="col"><span class="visually-hidden">Actions</span></th>
					</tr>
				</thead>
				<tbody>
					for _, a := range p.Apps {
						<tr>
							<td>{ a.Name }</td>
							<td>
								<ul class="scopes">
									<li>Know who you are</li>
									for _, s := range a.Scopes {
										<li>{ s.Description }</li>
									}
								</ul>
							</td>
							<td>{ a.GrantedAt.Format("2006-01-02") }</td>
							<td>
								<form method="post" action="/account/apps/revoke" class="inline" hx-post="/account/apps/revoke" hx-target="#page" hx-swap="innerHTML">
									<input type="hidden" name="_csrf" value={ p.CSRF }/>
									<input type="hidden" name="client_id" value={ a.ClientID }/>
									<button type="submit" class="link">Revoke { a.Name }</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</section>
	}
	<section aria-labelledby="sessions-heading">
		<h2 id="sessions-heading">Sessions</h2>
		<form method="post" action="/auth/logout" hx-post="/auth/logout">
			<input type="hidden" name="_csrf" value={ p.CSRF }/>
			<input type="hidden" name="everywhere" value="1"/>
			<button type="submit">Log out everywhere</button>
		</form>
	</section>
	if !p.Org.Owned {
		<section aria-labelledby="claim-heading">
			<h2 id="claim-heading">Claim this hub</h2>
			<p>This hub has no owner yet. Paste the owner-claim token from its log to become the owner.</p>
			<form method="post" action="/account/claim" hx-post="/account/claim" hx-target="#page" hx-swap="innerHTML">
				<input type="hidden" name="_csrf" value={ p.CSRF }/>
				<label for="token">Owner-claim token</label>
				<input id="token" name="token" type="text" autocomplete="off" required/>
				<button type="submit">Claim ownership</button>
			</form>
		</section>
	}
}

// Error is the whole error page.
templ Error(p ErrorPage) {
	@Layout(p.Page) {
		@ErrorContent(p)
	}
}

// ErrorContent explains a refusal or a failure; an htmx request gets only this.
templ ErrorContent(p ErrorPage) {
	<h1>{ p.Title }</h1>
	<p>{ p.Message }</p>
	<p>
		if p.User != nil {
			<a href="/account">Back to your account</a>
		} else {
			<a href="/login">Back to the login page</a>
		}
	</p>
}

// Proof is a code the member just got (gravel#5): shown once, with where to type it and what
// became of it.
templ Proof(p ProofPage) {
	@Layout(p.Page) {
		@ProofContent(p)
	}
}

// ProofContent is Proof without the layout, for htmx.
templ ProofContent(p ProofPage) {
	<h1>Your code</h1>
	<p class="code"><code>{ p.Code }</code></p>
	<p>{ p.Instructions }</p>
	<p>
		The server: { p.ServerName }
		if p.Join != nil {
			<code>{ p.Join.Value }</code>
		}
	</p>
	if p.Join != nil && p.Join.Hint != "" {
		<p class="muted">{ p.Join.Hint }</p>
	}
	<p class="muted">Good until { at(p.ExpiresAt) }, and only once. It is shown only here: leaving this page means getting a new one.</p>
	@ProofStatusView(p.Status)
	<p><a href="/account">Back to your account</a></p>
}

// ProofStatusView is what became of the code; while it is open it asks again every five seconds.
templ ProofStatusView(s ProofStatus) {
	if s.State == "open" {
		<div id="proof-status" role="status" hx-get={ "/account/prove/" + s.ID } hx-trigger="every 5s" hx-swap="outerHTML">
			<p>Waiting for the code in the server's chat.</p>
		</div>
	} else {
		<div id="proof-status" role="status">
			switch s.State {
				case "proven":
					<p class="flash flash-ok">Done: your { s.ProviderDisplay } account <code>{ s.Subject }</code> is linked and proven.</p>
				case "taken":
					<p class="flash flash-err">That { s.ProviderDisplay } account is linked to another member, so nothing changed. If it is yours, ask the hub's owner.</p>
				case "replaced":
					<p class="muted">A newer code took this one's place.</p>
				default:
					<p class="muted">This code expired. Get a new one on your account page.</p>
			}
		</div>
	}
}
